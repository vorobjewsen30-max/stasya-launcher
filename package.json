{
  "name": "stasya-launcher",
  "version": "0.4.0",
  "description": "Stasya Launcher — Minecraft Java launcher with Modrinth and mrpack support",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build": "node scripts/build.cjs"
  },
  "keywords": [],
  "author": "Stasya Launcher",
  "license": "MIT",
  "type": "commonjs",
  "overrides": {
    "undici": "^7.29.1"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.1",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "adm-zip": "0.6.1",
    "undici": "^7.29.1"
  },
  "build": {
    "appId": "dev.stasya.launcher",
    "productName": "Stasya Launcher",
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "ui/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/app-icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Stasya-Launcher-${version}-Windows-x64.exe"
    }
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vorobjewsen30-max/stasya-launcher.git"
  },
  "homepage": "https://github.com/vorobjewsen30-max/stasya-launcher",
  "bugs": {
    "url": "https://github.com/vorobjewsen30-max/stasya-launcher/issues"
  }
}
